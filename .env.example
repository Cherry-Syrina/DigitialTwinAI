# GlucoTwin AI — optional environment overrides.
# All variables are optional; defaults (see backend/app/config.py) work out of the box.

# Where synthetic CSVs are generated / read
GLUCOTWIN_DATA_DIR=data/synthetic

# Where model artifacts live
GLUCOTWIN_MODELS_DIR=models

# Risk thresholds file (JSON): {"hypo_low_mgdl":70,"hyper_high_mgdl":180,...}
GLUCOTWIN_THRESHOLDS_FILE=backend/app/data/thresholds.json

# Comma-separated CORS allow-list for the SPA
GLUCOTWIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:4173